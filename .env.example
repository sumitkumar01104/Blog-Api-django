SECRET_KEY=change-me
DEBUG=True
# Either DATABASE_URL (Neon/Supabase) ...
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# ... or the DB_* values below
DB_NAME=blogdb
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
# Optional
